{
  "expo": {
    "name": "ZAID",
    "slug": "zaid-mobile-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "owner": "arioveisa",
    "icon": "./assets/brand/zaid-icon.png",
    "scheme": "zaidmobileapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "id.zaid.assistant"
    },
    "android": {
      "package": "id.zaid.assistant",
      "adaptiveIcon": {
        "backgroundColor": "#160D20",
        "foregroundImage": "./assets/brand/zaid-icon.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/zaid-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/zaid-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#615FFF",
          "dark": {
            "backgroundColor": "#615FFF"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#A855F7",
          "defaultChannel": "reminders"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "74882b10-fbb9-40dc-a321-37f89f19eccb"
      }
    }
  }
}
